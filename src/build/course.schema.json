{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/curate-course/course.schema.json",
  "title": "課程設定檔",
  "description": "course/course.config.json 的結構。編輯器靠它自動完成，audit.py 靠它擋拼字錯誤。",
  "type": "object",
  "required": [
    "site",
    "ui",
    "kinds",
    "chapters"
  ],
  "properties": {
    "frameworkVersion": {
      "type": "string",
      "description": "這份設定檔寫給哪一版框架（semver）。只有主版號有意義：主版號對得上就保證相容，對不上代表中間有破壞性變更，make audit 會擋下來並指向 docs/MIGRATION.md。沒填視為 v1。",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "site": {
      "type": "object",
      "description": "站台身分，直接餵給 SEO 與 JSON-LD",
      "required": [
        "project",
        "name",
        "url",
        "title",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "description": "Cloudflare Pages 專案名",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "locale": {
          "type": "string",
          "description": "BCP-47，例如 zh-Hant"
        },
        "ogLocale": {
          "type": "string",
          "description": "OG 用底線寫法，例如 zh_TW"
        },
        "brandIcon": {
          "$ref": "#/$defs/icon"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "ogDescription": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "educationalLevel": {
          "type": "string",
          "description": "schema.org 的 educationalLevel，例如 Beginner；不設定就不宣告（框架不替你猜難度）"
        },
        "audience": {
          "type": "string"
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learningResourceType": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacyStorePrefix": {
          "type": "string",
          "description": "舊版 localStorage 前綴（例如 \"bc:\"）。前綴改成跟著 project 走之後，有設這個欄位才會把舊資料搬過來，既有使用者的進度才不會消失。新課程不需要設。",
          "pattern": "^[a-zA-Z0-9-]+:$"
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "lede": {
          "type": "string",
          "description": "首頁大標下方的說明段。可用文案佔位符 {units} {lessonUnits} {drillUnits} {slots} {videos} {problems} {evidence}"
        }
      }
    },
    "og": {
      "type": "object",
      "description": "社群預覽圖（dist/og.html → make og）。全部可省略，省略就退回 hero 與 site 的值；數字一律由 build 算出，不在這裡手寫",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "大標；換行字元會變成 <br>。預設用 hero.heading"
        },
        "lede": {
          "type": "string",
          "description": "副標；換行字元會變成 <br>。可用文案佔位符 {units} {lessonUnits} {drillUnits} {slots} {videos} {problems} {evidence}。預設用 site.ogDescription"
        },
        "stats": {
          "type": "array",
          "description": "圖上的統計數字，預設取 ui.stats 前四項",
          "items": {
            "type": "object",
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "description": "course.json 的 meta 欄位，另外可用 duration_hours（整數小時）"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "evidenceIcon": {
          "$ref": "#/$defs/icon"
        },
        "evidenceLabel": {
          "type": "string",
          "description": "分級列上方那句話；預設用 ui.evidenceSource 組出來"
        },
        "url": {
          "type": "string",
          "description": "頁尾網域；預設把 site.url 去掉 scheme"
        }
      }
    },
    "ui": {
      "type": "object",
      "description": "所有介面文案，程式裡不寫死任何一個字。additionalProperties 是 false：拼錯的欄位會被 make audit 擋下來，而不是靜靜地退回框架的預設字串",
      "properties": {
        "stats": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/icon"
              },
              "field": {
                "type": "string",
                "description": "必須是 build 產出的 meta 欄位"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "tabs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "unitTypes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "problemType": {
          "type": "string",
          "description": "要計入「問題數」的 unitType"
        },
        "evidenceRows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "text",
                  "flags"
                ]
              }
            }
          }
        },
        "unitNoun": {
          "type": "string",
          "description": "單元的稱呼，例如「個單元」「個主題」（預設「個單元」）"
        },
        "lessonNoun": {
          "type": "string",
          "description": "主課的稱呼，例如「堂主課」（預設「堂主課」）"
        },
        "drillNoun": {
          "type": "string",
          "description": "項目的稱呼，例如「支跟練影片」「支延伸影片」（預設「支跟練影片」）"
        },
        "drillNounShort": {
          "type": "string",
          "description": "項目的簡稱，用在空間窄的章節卡片（預設「支跟練」）"
        },
        "kindFilterLabel": {
          "type": "string",
          "description": "篩選列的無障礙標籤（預設「動作類型篩選」）"
        },
        "missingTitle": {
          "type": "string",
          "description": "找不到合格影片時的標題（預設「尚未找到合格影片」）"
        },
        "missingHint": {
          "type": "string",
          "description": "找不到合格影片時的預設說明（各格可用 note 覆寫）（預設「這個主題在 YouTube 上沒有品質足夠的示範」）"
        },
        "lessonLangLabel": {
          "type": "string",
          "description": "主課語言分頁的無障礙標籤（預設「主課語言」）"
        },
        "watchLabel": {
          "type": "string",
          "description": "項目連結的預設 title（預設「觀看示範」）"
        },
        "facetFilterHint": {
          "type": "string",
          "description": "分面標籤的 title，{name} 會被替換成標籤名（預設「篩選涉及 {name} 的內容」）"
        },
        "facetIcon": {
          "$ref": "#/$defs/icon",
          "description": "分面篩選面板的圖示，不設就用中性的 sliders-horizontal"
        },
        "evidenceSource": {
          "type": "string",
          "description": "實證查核的來源名稱，例如 OpenEvidence。留空則不顯示這個標籤（預設「OpenEvidence」）"
        },
        "evidenceSourceLink": {
          "type": "string",
          "description": "連到完整查核結果的連結文字（預設「在 OpenEvidence 讀完整回答」）"
        },
        "searchPlaceholder": {
          "type": "string",
          "description": "header 搜尋框的 placeholder（index.html 首屏就注入）"
        },
        "playlistSearch": {
          "type": "string",
          "description": "上課模式播放清單搜尋框的 placeholder"
        },
        "progressLabel": {
          "type": "string",
          "description": "側欄學習進度面板的標題"
        },
        "facetLabel": {
          "type": "string",
          "description": "分面篩選面板的標題"
        },
        "facetClear": {
          "type": "string",
          "description": "清掉所有分面選擇的按鈕文字"
        },
        "facetPrefix": {
          "type": "string",
          "description": "篩選計數列裡分面的前綴，也用在 build 的輸出（預設「分面」）"
        },
        "categoryNoun": {
          "type": "string",
          "description": "類別的稱呼，用在 build 的輸出（預設「類別」）"
        },
        "assessmentLabel": {
          "type": "string",
          "description": "單元自我評估區塊的小標"
        },
        "unitEvidenceLabel": {
          "type": "string",
          "description": "單元層級實證區塊的標題"
        },
        "drillEvidenceLabel": {
          "type": "string",
          "description": "類別層級實證區塊的標題"
        },
        "tightLabel": {
          "type": "string",
          "description": "兩欄對照清單左邊那一欄的小標"
        },
        "weakLabel": {
          "type": "string",
          "description": "兩欄對照清單右邊那一欄的小標"
        },
        "lessonLabel": {
          "type": "string",
          "description": "播放清單與播放器裡「主課」的標籤"
        },
        "doneLabel": {
          "type": "string",
          "description": "上課模式「標記完成」按鈕的文字"
        },
        "prevLabel": {
          "type": "string",
          "description": "上課模式「上一支」按鈕的文字"
        },
        "nextLabel": {
          "type": "string",
          "description": "上課模式「下一支」按鈕的文字"
        },
        "moreLabel": {
          "type": "string",
          "description": "上課模式補充說明摺疊區的文字"
        },
        "openExternal": {
          "type": "string",
          "description": "在 YouTube 開啟的連結 title"
        },
        "emptyTitle": {
          "type": "string",
          "description": "篩選後沒有結果時的標題"
        },
        "emptyHint": {
          "type": "string",
          "description": "篩選後沒有結果時的說明"
        },
        "discussLabel": {
          "type": "string",
          "description": "討論面板的標題（要設定 discussions 才會出現）"
        },
        "discussNote": {
          "type": "string",
          "description": "討論面板的說明"
        }
      },
      "additionalProperties": false
    },
    "kinds": {
      "type": "array",
      "description": "單元底下的項目類型，至少一種",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/labelled"
      }
    },
    "grades": {
      "type": "array",
      "description": "證據分級；沒有實證維度就整個拿掉",
      "items": {
        "$ref": "#/$defs/labelled"
      }
    },
    "languages": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "icons": {
      "type": "array",
      "description": "額外要打包進 sprite 的 Lucide 圖示。build_icons.py 已經會自動掃出所有 icon／xxxIcon 欄位，這裡是給設定檔以外（course/assets 自訂樣板）用的逃生門。",
      "items": {
        "$ref": "#/$defs/icon"
      }
    },
    "taxonomy": {
      "type": "object",
      "description": "選用的詞彙模組，值是 course/ 底下的 import 路徑",
      "additionalProperties": false,
      "properties": {
        "facets": {
          "type": "string",
          "description": "需提供 extract() / GROUPS / GROUP_OF"
        },
        "categories": {
          "type": "string",
          "description": "需提供 classify() / NAMES"
        }
      }
    },
    "nav": {
      "type": "array",
      "description": "側欄分組，必須不多不少涵蓋所有章節",
      "items": {
        "type": "object",
        "required": [
          "title",
          "chapters"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "title",
          "icon",
          "source",
          "units"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z]+[0-9]*$"
          },
          "title": {
            "type": "string"
          },
          "icon": {
            "$ref": "#/$defs/icon"
          },
          "source": {
            "type": "string",
            "description": "data/<source>.json，可多章共用一檔"
          },
          "units": {
            "type": "integer",
            "minimum": 0,
            "description": "配額：建置時強制檢查"
          },
          "drills": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "evidenceAlias": {
      "type": "object",
      "description": "unit id → 實證資料的 key，用在共用同一份查核的單元",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stance": {
      "type": "object",
      "description": "立場聲明頁的文案。intro 與 outro 是同一組長文，行為一致",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "description": "立場聲明頁的標題，也用在 llms.txt"
        },
        "intro": {
          "type": "string",
          "description": "標題底下的開場段"
        },
        "outroTitle": {
          "type": "string",
          "description": "結語的小標"
        },
        "outro": {
          "type": "string",
          "description": "結語段"
        },
        "keyPrefix": {
          "type": "string",
          "description": "立場聲明在資料檔裡的 key 前綴（預設 concept-）"
        },
        "verdicts": {
          "type": "object",
          "description": "unit id → 一句話結論，顯示在立場卡片與首頁",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "landing": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "body"
            ],
            "additionalProperties": false,
            "properties": {
              "icon": {
                "$ref": "#/$defs/icon"
              },
              "title": {
                "type": "string"
              },
              "body": {
                "type": "string"
              }
            }
          }
        },
        "ctaLede": {
          "type": "string",
          "description": "最下方行動呼籲的說明。可用文案佔位符 {units} {lessonUnits} {drillUnits} {slots} {videos} {problems} {evidence}"
        },
        "howTitle": {
          "type": "string",
          "description": "「怎麼用這門課」區塊的標題"
        },
        "stanceTitle": {
          "type": "string",
          "description": "立場聲明區塊的標題"
        },
        "stanceLede": {
          "type": "string",
          "description": "立場聲明區塊的說明段"
        },
        "chaptersTitle": {
          "type": "string",
          "description": "章節總覽區塊的標題"
        },
        "ctaTitle": {
          "type": "string",
          "description": "最下方行動呼籲的標題"
        }
      },
      "description": "首頁各區塊的文案",
      "additionalProperties": false
    },
    "footer": {
      "type": "object",
      "description": "頁尾兩行，index.html 首屏就注入",
      "additionalProperties": false,
      "properties": {
        "disclaimer": {
          "type": "string",
          "description": "頁尾第一行（收合狀態下唯一看得到的那一行）"
        },
        "credits": {
          "type": "string",
          "description": "展開後的版權說明"
        }
      }
    },
    "llms": {
      "type": "object",
      "description": "llms.txt 的整份模板。純文字檔（Markdown 風格），不涉及 HTML：文案原樣輸出，不逸出也不展開 `**粗體**`（`**` 在這裡本來就是 Markdown 的粗體）。框架只提供 `#`/`##`/`-`/空行這些結構，一個字都不寫——沒宣告的欄位就整塊不輸出。除了 {units} 這類數字佔位符，還可以用 [[course]] [[url]] [[durationHours]] [[durationMinutes]]",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "description": "開頭那一段課程摘要（緊接在 # 標題與 > 描述之後）。課程規模的數字要自己寫進來：{units} {lessonUnits} {drillUnits} {slots} {videos} {problems} {evidence}，總長用 [[durationHours]] 與 [[durationMinutes]]"
        },
        "stanceTitle": {
          "type": "string",
          "description": "立場聲明段的標題文字（框架加上 `## `）。沒寫就退回 stance.title；兩個都沒有就沒有標題"
        },
        "stanceIntro": {
          "type": "string",
          "description": "立場聲明段的開場。可用文案佔位符 {units} {lessonUnits} {drillUnits} {slots} {videos} {problems} {evidence}"
        },
        "stanceItem": {
          "type": "string",
          "description": "立場聲明每一條的模板（框架加上 `- `）。可用 [[name]] [[grade]] [[summary]] [[summaryShort]]（前 180 字，不含刪節號——要不要加「…」由你決定）。沒寫就不列任何一條"
        },
        "stanceConclusion": {
          "type": "string",
          "description": "立場聲明段的結語"
        },
        "chaptersTitle": {
          "type": "string",
          "description": "章節段的標題文字（框架加上 `## `）。沒寫就只有清單、沒有標題"
        },
        "chapterItem": {
          "type": "string",
          "description": "章節每一行的模板（框架加上 `- `）。可用 [[code]] [[title]] [[units]]（單元名清單）[[unitCount]]。沒寫就不列章節"
        },
        "unitSeparator": {
          "type": "string",
          "description": "[[units]] 串接單元名用的分隔符。中日韓通常是「、」，拉丁語系是「, 」。沒寫而又用了 [[units]] 會退回 \", \" 並警告"
        },
        "disclaimerTitle": {
          "type": "string",
          "description": "免責段的標題文字（框架加上 `## `）"
        },
        "disclaimer": {
          "type": "string",
          "description": "免責段。沒寫就整段不輸出（連標題也不會出現）"
        },
        "footer": {
          "type": "string",
          "description": "結尾帶出網站本體的那一行，通常放 [[url]]。沒寫就只印裸網址——網址是這份檔案的功能，但帶出它的那句話是文案"
        }
      }
    },
    "paywall": {
      "type": "object",
      "description": "選用：加入購物車 + 0 元結帳的解鎖流程。整組拿掉就完全不存在。設計與接真金流的待辦見 docs/PAYWALL.md。",
      "additionalProperties": false,
      "required": [
        "mode",
        "products"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "demo"
          ],
          "description": "demo = 0 元本地結帳，解鎖狀態存 localStorage。live 尚未實作，填別的值會整組關掉（fail closed）。"
        },
        "currency": {
          "type": "string",
          "description": "ISO 幣別代碼，例如 TWD。只影響顯示的符號。"
        },
        "orderPrefix": {
          "type": "string",
          "description": "訂單編號前綴，例如 BC → BC-20260730-4F2A"
        },
        "freeChapters": {
          "type": "array",
          "description": "免費試看的章節代碼。不在這裡、也沒被任何 product 解鎖的章節就是鎖定。",
          "items": {
            "type": "string"
          }
        },
        "honesty": {
          "type": "string",
          "description": "必寫：講明這門課免費、劃掉的原價是虛構的。有 listAmount 就一定要有這行，不然是假折扣。"
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "amount"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "note": {
                "type": "string",
                "description": "品項下面的一行小字"
              },
              "amount": {
                "type": "number",
                "minimum": 0,
                "description": "實付金額。demo 應為 0。"
              },
              "listAmount": {
                "type": "number",
                "minimum": 0,
                "description": "被劃掉的原價。虛構的，所以要搭配 honesty。"
              },
              "unlocks": {
                "description": "\"*\" 解鎖全部，或章節代碼陣列",
                "oneOf": [
                  {
                    "type": "string",
                    "enum": [
                      "*"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              }
            }
          }
        },
        "ui": {
          "type": "object",
          "description": "全部文案。缺的欄位會退回程式碼裡的預設值。"
        }
      }
    },
    "counter": {
      "type": "object",
      "description": "選用：累計瀏覽次數徽章（Pages Function + D1）。整組拿掉就不顯示，也不會打 API。",
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "description": "數字後面的字，例如「次瀏覽」"
        },
        "title": {
          "type": "string",
          "description": "hover 時的說明，講清楚數的是什麼"
        }
      }
    },
    "discussions": {
      "type": "object",
      "description": "每支影片一串留言（giscus → GitHub Discussions）。整組拿掉就沒有討論面板。",
      "properties": {
        "setupNote": {
          "type": "string",
          "description": "給人看的設定提醒，程式不讀。三個識別碼換成自己的之後可以刪掉。"
        },
        "provider": {
          "type": "string",
          "enum": [
            "giscus"
          ]
        },
        "repo": {
          "type": "string",
          "description": "留言要送去的 GitHub repo（owner/name）。務必換成自己的——這個值填錯不會有任何錯誤，留言只會安靜地跑到別人家。make audit 會比對它是不是這個 checkout 的 origin。",
          "pattern": "^[\\w.-]+/[\\w.-]+$"
        },
        "allowExternalRepo": {
          "type": "boolean",
          "description": "刻意把留言送到「不是這個 checkout」的 repo 時設為 true，否則 make audit 會擋下來"
        },
        "repoId": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "categoryId": {
          "type": "string"
        },
        "mapping": {
          "type": "string"
        },
        "termPrefix": {
          "type": "string",
          "description": "討論串標題前綴，後面接 video id"
        },
        "lang": {
          "type": "string"
        },
        "reactions": {
          "type": "boolean"
        },
        "inputPosition": {
          "type": "string",
          "enum": [
            "top",
            "bottom"
          ]
        }
      }
    },
    "audit": {
      "type": "object",
      "description": "make audit 的門檻。沒寫的欄位用 audit.py 的 DEFAULTS。",
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "object",
          "description": "影片長度區間，超出只會警告——策展判斷仍是人的",
          "additionalProperties": false,
          "properties": {
            "lesson": {
              "$ref": "#/$defs/range"
            },
            "drill": {
              "$ref": "#/$defs/range"
            }
          }
        },
        "driftSeconds": {
          "type": "integer",
          "minimum": 0,
          "description": "策展資料宣稱的長度與實際中繼資料的容許誤差"
        },
        "minViews": {
          "type": "integer",
          "minimum": 0,
          "description": "低於此觀看數要人工看一眼"
        },
        "metaCoverage": {
          "type": "number",
          "minimum": 0,
          "description": "video-meta.json 必須覆蓋的影片比例（0–1），未達即錯誤"
        },
        "drillsPerUnit": {
          "type": "object",
          "additionalProperties": false,
          "description": "單一單元的項目數區間，用來抓策展失衡",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 0
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "maxSharedVideos": {
          "type": "integer",
          "minimum": 0,
          "description": "允許跨單元共用的影片支數"
        },
        "requireAssessment": {
          "type": "array",
          "description": "這些 unitType 的單元必須寫可操作的自我評估",
          "items": {
            "type": "string"
          }
        },
        "minAssessmentChars": {
          "type": "integer",
          "minimum": 0
        },
        "minCitations": {
          "type": "integer",
          "minimum": 0,
          "description": "每個文獻類別至少幾篇引用"
        },
        "allowMissingUrls": {
          "type": "integer",
          "minimum": 0,
          "description": "容許幾個誠實留空的格子"
        },
        "maxCategoryShare": {
          "type": "number",
          "minimum": 0,
          "description": "單一類別佔已分類項目的比例上限（0–1），超過只會警告：通常代表 patterns 用到了會出現在 target 欄位的詞"
        },
        "copyStyle": {
          "type": "object",
          "additionalProperties": false,
          "description": "文案的 AI 寫作痕跡檢查（只警告，且只在 site.locale 為 zh-* 時啟用）",
          "properties": {
            "maxDashRatio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "容許幾成的文案欄位用破折號。中文破折號有正當用法，量的是密度而不是單一實例——超過才報一則聚合警告。預設 0.05"
            }
          }
        },
        "ignoreDataFiles": {
          "type": "array",
          "description": "course/data/ 底下刻意不給建置讀的檔名；其餘讀不到的資料檔一律報錯",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "icon": {
      "type": "string",
      "description": "Lucide 圖示名，必須跑過 make icons 打包進這門課的 sprite",
      "pattern": "^[a-z0-9-]+$"
    },
    "labelled": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "label": {
          "type": "string"
        },
        "tone": {
          "type": "string",
          "description": "對應 .Label--<tone> 樣式",
          "enum": [
            "accent",
            "success",
            "attention",
            "danger",
            "done",
            "neutral"
          ]
        }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "pattern": "^\\d+:\\d{2}$"
        },
        "max": {
          "type": "string",
          "pattern": "^\\d+:\\d{2}$"
        }
      }
    }
  }
}
